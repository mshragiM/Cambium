#include <ap_int.h>
#include <ap_axi_sdata.h>
#include <hls_stream.h>

// Cambium signed fixed-point forest, quantized to {{ fixed_total_bits }} total bits
// with {{ fixed_frac_bits }} fractional bits. Primitive ROMs are visible to HLS.
static const int TREES = {{ n_trees_per_target }};
static const int FEATURES = {{ n_features }};
static const int DEPTH = {{ max_depth }};
static const int NODES = {{ max_nodes }};
static const int WIDTH = {{ fixed_total_bits }};
typedef ap_axiu<32,0,0,0> axis_t;

static const unsigned int FEATURE[TREES][NODES] = {
{% for tree in tree_data[0] %}
  { {% for value in tree.features %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
static const int THRESHOLD[TREES][NODES] = {
{% for tree in tree_data[0] %}
  { {% for value in tree.threshold_codes %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
static const int VALUE[TREES][NODES] = {
{% for tree in tree_data[0] %}
  { {% for value in tree.value_codes %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
static const unsigned int LEFT[TREES][NODES] = {
{% for tree in tree_data[0] %}
  { {% for value in tree.left_children %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
static const unsigned int RIGHT[TREES][NODES] = {
{% for tree in tree_data[0] %}
  { {% for value in tree.right_children %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
static const unsigned char LEAF[TREES][NODES] = {
{% for tree in tree_data[0] %}
  { {% for value in tree.is_leaf %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};

void predict_axi(hls::stream<axis_t>& in, hls::stream<axis_t>& out) {
#pragma HLS INTERFACE axis port=in
#pragma HLS INTERFACE axis port=out
#pragma HLS INTERFACE ap_ctrl_none port=return
    int features[FEATURES];
#pragma HLS ARRAY_PARTITION variable=features complete
    bool batch_last = false;
    for (int j=0; j<FEATURES; ++j) {
#pragma HLS PIPELINE II=1
        axis_t word = in.read();
        ap_int<WIDTH> signed_code;
        signed_code.range(WIDTH-1,0) = word.data.range(WIDTH-1,0);
        features[j] = int(signed_code);
        if (j == FEATURES-1) batch_last = bool(word.last);
    }
    long long total = 0;
    for (int tree=0; tree<TREES; ++tree) {
        unsigned int node = 0;
        for (int level=0; level<DEPTH; ++level) {
#pragma HLS PIPELINE II=1
            if (!LEAF[tree][node]) {
                unsigned int feature = FEATURE[tree][node];
                node = features[feature] <= THRESHOLD[tree][node] ?
                    LEFT[tree][node] : RIGHT[tree][node];
            }
        }
        total += VALUE[tree][node];
    }
    int average = int(total / TREES);
    axis_t result;
    result.data = ap_uint<WIDTH>(average);
    result.keep = 15;
    result.strb = 15;
    result.last = batch_last;
    out.write(result);
}
