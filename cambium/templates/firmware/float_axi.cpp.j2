#include <ap_int.h>
#include <ap_axi_sdata.h>
#include <hls_stream.h>

// Primitive tree ROMs avoid synthesis of aggregate TreeData objects.
static const int TREES = {{ n_trees_per_target }};
static const int FORESTS = {{ n_forests }};
static const int TOTAL_TREES = {{ n_forests * n_trees_per_target }};
static const int FEATURES = {{ n_features }};
static const int OUTPUTS = {{ n_targets }};
static const int DEPTH = {{ max_depth }};
static const int NODES = {{ max_nodes }};
typedef ap_axiu<32,0,0,0> axis_t;
union float_word_t { float value; unsigned int bits; };

static const unsigned int FEATURE[TOTAL_TREES][NODES] = {
{% for tree in flat_trees %}
  { {% for value in tree.features %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
static const float THRESHOLD[TOTAL_TREES][NODES] = {
{% for tree in flat_trees %}
  { {% for value in tree.thresholds %}{{ "%.9e"|format(value) }}f{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
{% if is_classification %}
static const float VALUE[TOTAL_TREES][NODES][OUTPUTS] = {
{% for tree in flat_trees %}
  { {% for row in tree.node_values %}{ {% for value in row %}{{ "%.9e"|format(value) }}f{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
{% else %}
static const float VALUE[TOTAL_TREES][NODES] = {
{% for tree in flat_trees %}
  { {% for value in tree.node_values %}{{ "%.9e"|format(value) }}f{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
{% endif %}
static const unsigned int LEFT[TOTAL_TREES][NODES] = {
{% for tree in flat_trees %}
  { {% for value in tree.left_children %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
static const unsigned int RIGHT[TOTAL_TREES][NODES] = {
{% for tree in flat_trees %}
  { {% for value in tree.right_children %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};
static const unsigned char LEAF[TOTAL_TREES][NODES] = {
{% for tree in flat_trees %}
  { {% for value in tree.is_leaf %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{% endfor %}
};

void predict_axi(hls::stream<axis_t>& in, hls::stream<axis_t>& out) {
#pragma HLS INTERFACE axis port=in
#pragma HLS INTERFACE axis port=out
#pragma HLS INTERFACE ap_ctrl_none port=return
    float features[FEATURES];
#pragma HLS ARRAY_PARTITION variable=features complete
    bool batch_last = false;
    for (int j=0; j<FEATURES; ++j) {
#pragma HLS PIPELINE II=1
        axis_t word = in.read();
        float_word_t decoded;
        decoded.bits = word.data.to_uint();
        features[j] = decoded.value;
        if (j == FEATURES-1) batch_last = bool(word.last);
    }
    float total[OUTPUTS];
#pragma HLS ARRAY_PARTITION variable=total complete
    for (int c=0; c<OUTPUTS; ++c) total[c] = 0.0f;
{% if is_classification %}
    for (int tree=0; tree<TREES; ++tree) {
        const int index = tree;
{% else %}
    for (int c=0; c<OUTPUTS; ++c) {
      for (int tree=0; tree<TREES; ++tree) {
        const int index = c * TREES + tree;
{% endif %}
        unsigned int node = 0;
        for (int level=0; level<DEPTH; ++level) {
#pragma HLS PIPELINE II=1
            if (!LEAF[index][node]) {
                unsigned int feature = FEATURE[index][node];
                node = features[feature] <= THRESHOLD[index][node] ?
                    LEFT[index][node] : RIGHT[index][node];
            }
        }
{% if is_classification %}
        for (int c=0; c<OUTPUTS; ++c) total[c] += VALUE[index][node][c];
{% else %}
        total[c] += VALUE[index][node];
{% endif %}
{% if not is_classification %}
      }
{% endif %}
    }
    for (int c=0; c<OUTPUTS; ++c) {
#pragma HLS PIPELINE II=1
        float_word_t encoded;
        encoded.value = total[c] / TREES;
        axis_t result;
        result.data = encoded.bits;
        result.keep = 15;
        result.strb = 15;
        result.last = batch_last && c == OUTPUTS-1;
        out.write(result);
    }
}
